{
	"name": "sveltier-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.15.0",
	"engines": {
		"node": ">=22.17.0"
	},
	"scripts": {
		"dev": "pnpm --filter @sveltier/ui build && pnpm --parallel --filter @sveltier/ui --filter @sveltier/docs dev",
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"test": "pnpm -r test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"size": "pnpm --filter @sveltier/ui size",
		"changeset": "changeset"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0"
	}
}
