{
	"name": "sveltier",
	"version": "0.0.0",
	"description": "A Svelte 5 UI framework with five built-in design languages, a zero-dependency theme engine and flash-free SSR theming.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sveltier/sveltier.git",
		"directory": "packages/sveltier"
	},
	"homepage": "https://github.com/sveltier/sveltier#readme",
	"bugs": {
		"url": "https://github.com/sveltier/sveltier/issues"
	},
	"type": "module",
	"scripts": {
		"build": "svelte-package && node scripts/strip-css-imports-from-dts.js && publint --strict && attw --pack . --profile esm-only --ignore-rules internal-resolution-error --quiet",
		"dev": "svelte-package --watch",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"size": "node scripts/size-bundle.js && size-limit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./themes/*": {
			"types": "./dist/themes/*.d.ts",
			"default": "./dist/themes/*.js"
		},
		"./styles/*.css": "./dist/styles/*.css",
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"svelte": "^5.40.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@size-limit/file": "^14.3.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^5.0.5",
		"playwright": "^1.64.1",
		"publint": "^0.3.25",
		"size-limit": "^14.3.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"ui",
		"components",
		"design-system",
		"fintech"
	]
}
